    <!-- Custom Tree for Estate OFFERS -->
    <record id="estate_offer_view_list" model="ir.ui.view">
        <field name="name">estate.offer.view.list</field>
        <field name="model">estate.property.offer</field>  
        <field name="arch" type="xml">
            <list string="Estate Offer Properties" editable="bottom" decoration-danger="status =='refused'" decoration-success="status == 'accepted' " > <!-- "tree" it's considered a legacy alias for "list."--> 
                <field name="price" string="Price" />
                <field name="property_type_id"/>

                <field name="partner_id" string="Partner" />
                <field name="validity" string="Validity" />
                <field name="date_deadline" string="Deadline" />
                <!--<button name="action_accept_offer" type="object" icon="fa-check" 
                invisible="status == 'accepted' or status == 'refused' "/>
                <button name="action_refuse_offer" type="object" icon="fa-times" 
                invisible="status == 'accepted' or status == 'refused' "/>--> 
                <button name="action_accept_offer" type="object" icon="fa-check"/>
                <button name="action_refuse_offer" type="object" icon="fa-times" />
                <!--<field name="status" string="Status" />--> 
            </list>
        </field>
    </record>

    <!-- Custom Form for Estate OFFERS -->
    <record id="estate_offer_property_view_form" model="ir.ui.view">
        <field name="name">estate.offer.property.view.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml"> 
            <form string="Estate Property Offer" >
                <sheet>  <!--<sheet>  Creates a structured form layout using <sheet> --> 
                    <group> <!--<group> this tag is required to display the field --> 
                        <group>
                            <field name="price" string="Price" />
                            <field name="partner_id" string="Partner" />
                            <field name="validity" string="Validity" />
                            <field name="date_deadline" string="Deadline" />
                            <field name="status" string="Status" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action for Estate OFFERS -->
    <!--By moving the definition of the action_view_offers_by_property_type action to appear before the view that uses it, you ensure that the external ID is already registered in Odoo's system when the form view is being processed. --> 
    <record id="action_view_offers_by_property_type" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('property_type_id', '=', active_id)]</field> <!--A domain that defines property_type_id as equal to the active_id the current record. The active_id is retrieved from the estate.property.type model when this code executes, as it is the active record from which the button is clicked.
) --> 
    </record>

                                            <!-- Section for Estate TYPE: --> 
    <record id="estate_type_property_view_list" model="ir.ui.view">
        <field name="name">estate.type.property.view.list</field>
        <field name="model">estate.property.type</field>  
        <field name="arch" type="xml">
            <list string="Estate Types"> <!-- "tree" it's considered a legacy alias for "list."--> 
                <field name="sequence" widget="handle"/>
                <field name="name" string="Type:"/>
            </list>
        </field>
    </record>

    <record id="estate_type_property_view_form" model="ir.ui.view">
    <field name="name">estate.type.property.view.form</field>
    <field name="model">estate.property.type</field>
    <field name="arch" type="xml"> 
        <form string="Estate Property Type" >
            <header>
                <button name="%(action_view_offers_by_property_type)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-handshake-o">
                    <field name="offer_count" widget="statinfo" string="Offers"/>
                </button>
            </header>

            <sheet> 
                <group> 
                    <group>
                        <field name="name" string="Type of Property:"/>
                    </group>
                </group>
                <notebook>
                    <page string="Properties">
                        <field name="property_ids">
                            <list>
                                <field name="name" string="Tile"/>
                                <field name="expected_price" string="Expected Price"/>
                                <field name="state" string="State"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </sheet>
        </form>
    </field>
    </record>

    <record id="estate_type_model_action" model="ir.actions.act_window">
        <field name="name">Real Estate Type action</field>
        <field name="res_model">estate.property.type</field>
